<UserControl
    x:Class="OtzarotApp.Controls.BookPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OtzarotApp.Controls"
    xmlns:vm="using:OtzarotApp.ViewModels"
    xmlns:models="using:OtzarotApp.Models"
    FlowDirection="RightToLeft"
    MinWidth="280" MinHeight="200">

    <!-- מסגרת חיצונית ברורה -->
    <Border x:Name="OuterBorder"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="2"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ══ resize handles — על כל הצדדים ══ -->

        <!-- Top edge — cursor SizeNS -->
        <Border Grid.Row="0"
                Height="5" VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                Canvas.ZIndex="20"
                PointerPressed="TopEdge_PointerPressed"
                PointerMoved="TopEdge_PointerMoved"
                PointerReleased="Edge_PointerReleased"
                PointerEntered="TopBottomEdge_PointerEntered"
                PointerExited="Edge_PointerExited"/>

        <!-- Bottom edge — cursor SizeNS -->
        <Border Grid.Row="2"
                Height="5" VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                Canvas.ZIndex="20"
                PointerPressed="BottomEdge_PointerPressed"
                PointerMoved="BottomEdge_PointerMoved"
                PointerReleased="Edge_PointerReleased"
                PointerEntered="TopBottomEdge_PointerEntered"
                PointerExited="Edge_PointerExited"/>

        <!-- Left edge — cursor SizeWE -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Width="5" HorizontalAlignment="Left"
                Background="Transparent"
                Canvas.ZIndex="20"
                PointerPressed="LeftEdge_PointerPressed"
                PointerMoved="LeftEdge_PointerMoved"
                PointerReleased="Edge_PointerReleased"
                PointerEntered="LeftRightEdge_PointerEntered"
                PointerExited="Edge_PointerExited"/>

        <!-- Right edge — cursor SizeWE -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Width="5" HorizontalAlignment="Right"
                Background="Transparent"
                Canvas.ZIndex="20"
                PointerPressed="RightEdge_PointerPressed"
                PointerMoved="RightEdge_PointerMoved"
                PointerReleased="Edge_PointerReleased"
                PointerEntered="LeftRightEdge_PointerEntered"
                PointerExited="Edge_PointerExited"/>

        <!-- ══ כותרת חלון — כמו Windows עברי ══
             כותרת מימין, כפתורי שליטה משמאל               -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="6,6,0,0"
                x:Name="TitleBar"
                PointerPressed="TitleBar_PointerPressed"
                PointerMoved="TitleBar_PointerMoved"
                PointerReleased="TitleBar_PointerReleased">

            <!-- FlowDirection="LeftToRight" כדי שכפתורים יהיו משמאל כמו Windows -->
            <Grid FlowDirection="LeftToRight"
                  ColumnDefinitions="Auto,Auto,Auto,8,*,Auto,Auto,Auto"
                  Padding="4,4,8,4">

                <!-- כפתור סגירה — X — קיצוני שמאל -->
                <Button Grid.Column="0"
                        x:Name="CloseBtn"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="32" Height="28" Padding="0"
                        ToolTipService.ToolTip="סגור"
                        Click="Close_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="12"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                </Button>

                <!-- כפתור מזעור -->
                <Button Grid.Column="1"
                        x:Name="MinimizeBtn"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="32" Height="28" Padding="0"
                        ToolTipService.ToolTip="מזעור"
                        Click="Minimize_Click">
                    <FontIcon Glyph="&#xE921;" FontSize="12"/>
                </Button>

                <!-- כפתור הגדל/שחזר -->
                <Button Grid.Column="2"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="32" Height="28" Padding="0"
                        Click="Maximize_Click"
                        ToolTipService.ToolTip="הגדל">
                    <FontIcon x:Name="MaximizeIcon" Glyph="&#xE922;" FontSize="12"/>
                </Button>

                <!-- מפריד -->
                <Border Grid.Column="3"
                        Width="1" Height="16"
                        VerticalAlignment="Center"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Opacity="0.5"/>

                <!-- כותרת הספר + מיקום — מימין, לחיצה פותחת TOC -->
                <Button Grid.Column="4"
                        FlowDirection="RightToLeft"
                        Style="{StaticResource SubtleButtonStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Right"
                        Click="LocationBreadcrumb_Click"
                        Padding="6,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" FlowDirection="RightToLeft">
                        <TextBlock x:Name="BookTitleText"
                                   FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                        <FontIcon Glyph="&#xE76C;" FontSize="9" Opacity="0.5"
                                  VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeRefText"
                                   FontSize="11" Opacity="0.65"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                    </StackPanel>
                </Button>

                <!-- הגדל גופן -->
                <Button Grid.Column="5"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="30" Height="28" Padding="0"
                        Click="IncreaseFontSize_Click"
                        ToolTipService.ToolTip="הגדל גופן">
                    <FontIcon Glyph="&#xE8E8;" FontSize="12"/>
                </Button>

                <!-- הקטן גופן -->
                <Button Grid.Column="6"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="30" Height="28" Padding="0"
                        Click="DecreaseFontSize_Click"
                        ToolTipService.ToolTip="הקטן גופן">
                    <FontIcon Glyph="&#xE8E7;" FontSize="12"/>
                </Button>

                <!-- מפרשים -->
                <Button Grid.Column="7"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="8,4"
                        Click="Commentary_Click"
                        ToolTipService.ToolTip="מפרשים">
                    <StackPanel Orientation="Horizontal" Spacing="4" FlowDirection="RightToLeft">
                        <FontIcon Glyph="&#xE90A;" FontSize="13"/>
                        <TextBlock Text="מפרשים" FontSize="12"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- ══ תוכן ספר ══ -->
        <Grid Grid.Row="1">
            <ProgressRing x:Name="LoadingRing"
                          IsActive="False"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="48" Height="48"/>

            <WebView2 x:Name="ContentWebView"
                      NavigationCompleted="WebView_NavigationCompleted"/>

            <!-- פאנל TOC — שכבה מעל WebView מצד ימין -->
            <Border x:Name="TocPanel"
                    HorizontalAlignment="Right"
                    Width="240"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" Padding="8,6" ColumnDefinitions="*,Auto"
                          FlowDirection="RightToLeft">
                        <TextBlock Grid.Column="0" Text="תוכן עניינים"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource SubtleButtonStyle}"
                                Width="24" Height="24" Padding="0"
                                Click="CloseToc_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="10"/>
                        </Button>
                    </Grid>
                    <TreeView Grid.Row="1" x:Name="TocTreeView"
                              FlowDirection="RightToLeft"
                              ItemsSource="{x:Bind ViewModel.TocRoots, Mode=OneWay}"
                              ItemInvoked="TocEntry_Invoked">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="models:TocEntry">
                                <TextBlock Text="{x:Bind Title}"/>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Popup מפרשים -->
            <Popup x:Name="CommentaryPopup"
                   IsLightDismissEnabled="True">
                <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Width="280" MaxHeight="400" Padding="4">
                    <Grid RowDefinitions="Auto,*" FlowDirection="RightToLeft">
                        <TextBlock Grid.Row="0" Text="מפרשים ופירושים"
                                   FontWeight="SemiBold" Padding="8,8,8,4"/>
                        <ListView Grid.Row="1" x:Name="CommentaryList"
                                  ItemsSource="{x:Bind ViewModel.Commentaries, Mode=OneWay}"
                                  ItemClick="Commentary_ItemClick"
                                  IsItemClickEnabled="True">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Commentary">
                                    <Grid ColumnDefinitions="*,Auto" Padding="4,6">
                                        <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind LinkType}"
                                                   FontSize="11" Opacity="0.6"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Popup>
        </Grid>

        <!-- ══ שורה תחתונה ══ -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,6,6"
                Padding="4,2">
            <Grid FlowDirection="LeftToRight" ColumnDefinitions="Auto,*,Auto">

                <!-- Resize handle פינה שמאל תחתונה -->
                <Border Grid.Column="0"
                        Width="18" Height="18"
                        PointerPressed="ResizeHandle_PointerPressed"
                        PointerMoved="ResizeHandle_PointerMoved"
                        PointerReleased="ResizeHandle_PointerReleased"
                        PointerEntered="ResizeHandle_PointerEntered"
                        PointerExited="Edge_PointerExited">
                    <FontIcon Glyph="&#xE76F;" FontSize="10" Opacity="0.45"
                              FlowDirection="LeftToRight"/>
                </Border>

                <!-- טען עוד — מרכז -->
                <Button Grid.Column="1" x:Name="LoadMoreBtn"
                        Content="טען עוד..."
                        FlowDirection="RightToLeft"
                        Style="{StaticResource SubtleButtonStyle}"
                        HorizontalAlignment="Center"
                        FontSize="12" Padding="6,2"
                        Click="LoadMore_Click"/>

            </Grid>
        </Border>

    </Grid>
    </Border>

</UserControl>
