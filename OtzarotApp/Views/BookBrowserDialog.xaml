<ContentDialog
    x:Class="OtzarotApp.Views.BookBrowserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OtzarotApp.Models"
    FlowDirection="RightToLeft"
    Title="בחר ספר"
    PrimaryButtonText="פתח"
    CloseButtonText="ביטול"
    DefaultButton="Primary"
    MinWidth="500"
    MinHeight="600">

    <Grid RowDefinitions="Auto,Auto,*" Height="520">

        <!-- חיפוש -->
        <TextBox Grid.Row="0"
                 x:Name="SearchBox"
                 PlaceholderText="חפש ספר..."
                 Margin="0,0,0,8"
                 TextChanged="SearchBox_TextChanged"/>

        <!-- מודל בחירה: עץ / רשימה -->
        <Pivot Grid.Row="1" x:Name="BrowsePivot" Margin="0,0,0,4">
            <PivotItem Header="עץ קטגוריות"/>
            <PivotItem Header="חיפוש"/>
        </Pivot>

        <!-- תוצאות -->
        <Grid Grid.Row="2">

            <!-- עץ קטגוריות -->
            <TreeView x:Name="CategoryTree"
                      Visibility="Visible"
                      ItemInvoked="CategoryTree_ItemInvoked"
                      Expanding="CategoryTree_Expanding">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="models:Category">
                        <TextBlock Text="{x:Bind Title}"/>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- תוצאות חיפוש -->
            <ListView x:Name="SearchResultsList"
                      Visibility="Collapsed"
                      IsItemClickEnabled="True"
                      ItemClick="SearchResult_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Book">
                        <Grid ColumnDefinitions="*,Auto" Padding="4,6">
                            <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind HeShortDesc}"
                                       FontSize="11" Opacity="0.6"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="160"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Grid>
    </Grid>

</ContentDialog>
