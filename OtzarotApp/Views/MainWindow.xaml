<Window
    x:Class="OtzarotApp.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OtzarotApp.Views"
    xmlns:controls="using:OtzarotApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="אוצרות — ספרי קודש">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto">

        <!-- ══ שורה עליונה: תפריט + חיפוש + הגדרות ══ -->
        <Border Grid.Row="0"
                Background="{ThemeResource NavigationViewTopPaneBackground}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid Padding="8,4" ColumnDefinitions="Auto,*,320,*,Auto">

                <!-- כפתור הגדרות (ימין) -->
                <Button Grid.Column="0"
                        Click="Settings_Click"
                        Padding="8,4"
                        Margin="4,0"
                        ToolTipService.ToolTip="הגדרות"
                        Background="Transparent"
                        BorderThickness="0">
                    <FontIcon Glyph="&#xE713;" FontSize="16"/>
                </Button>

                <!-- תפריט (שמאל) -->
                <MenuBar Grid.Column="4" FlowDirection="RightToLeft">
                    <MenuBarItem Title="עיון">
                        <MenuFlyoutItem Text="פתח ספר..." Click="OpenBook_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="O"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="סגור חלון" Click="CloseActivePanel_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="W"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuBarItem>

                    <MenuBarItem Title="חיפוש">
                        <MenuFlyoutItem Text="חיפוש מתקדם..." Click="OpenSearch_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="F"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuBarItem>

                    <MenuBarItem Title="תצוגה">
                        <MenuFlyoutItem Text="הגדל טקסט" Click="IncreaseFontSize_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="Add"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="הקטן טקסט" Click="DecreaseFontSize_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="Subtract"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="מסך מלא" Click="FullScreen_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F11"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuBarItem>

                    <MenuBarItem Title="כלים">
                        <MenuFlyoutItem Text="בניית אינדקס חיפוש" Click="BuildIndex_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="הגדרות..." Click="Settings_Click"/>
                    </MenuBarItem>

                    <MenuBarItem Title="עזרה">
                        <MenuFlyoutItem Text="אודות אוצרות" Click="About_Click"/>
                    </MenuBarItem>
                </MenuBar>

                <!-- תיבת חיפוש עם השלמה אוטומטית -->
                <AutoSuggestBox Grid.Column="2"
                    x:Name="MainSearchBox"
                    PlaceholderText="חפש ספר... (ברכות ב׳)"
                    QueryIcon="Find"
                    FlowDirection="RightToLeft"
                    TextChanged="SearchBox_TextChanged"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    SuggestionChosen="SearchBox_SuggestionChosen"/>
            </Grid>
        </Border>

        <!-- ══ אזור ספרים ══ -->
        <Grid Grid.Row="1" x:Name="BooksArea">

            <!-- מסך ברוך הבא -->
            <StackPanel x:Name="WelcomePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <FontIcon Glyph="&#xE736;" FontSize="72"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="אוצרות"
                           FontSize="36" FontWeight="Light"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="חפש ספר בתיבת החיפוש למעלה כדי להתחיל"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <Button Content="פתח ספר..."
                        HorizontalAlignment="Center"
                        Click="OpenBook_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>

            <!-- Canvas לחלונות הספרים -->
            <controls:BookCanvasPanel x:Name="BookCanvas"/>
        </Grid>

        <!-- ══ שורת סטטוס תחתונה ══ -->
        <Border Grid.Row="2"
                Background="{ThemeResource NavigationViewTopPaneBackground}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,3">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="ServerStatusText"
                           Grid.Column="1"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>

    </Grid>
</Window>
