<ContentDialog
    x:Class="OtzarotApp.Views.SearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OtzarotApp.Models"
    FlowDirection="RightToLeft"
    Title="חיפוש מתקדם"
    CloseButtonText="סגור"
    MinWidth="680">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Width="640" MaxHeight="700">

        <!-- ─── שורת חיפוש ─────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0"
                     x:Name="QueryBox"
                     PlaceholderText="הקלד ביטוי חיפוש... (תומך AND OR NOT &quot;ביטוי מדויק&quot;)"
                     Text="{x:Bind ViewModel.Query, Mode=TwoWay}"
                     KeyDown="Query_KeyDown"
                     Margin="0,0,8,0"/>
            <Button Grid.Column="1"
                    Content="חפש"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    IsEnabled="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BoolNegConverter}}"/>
        </Grid>

        <!-- ─── אפשרויות חיפוש ────────────────────────── -->
        <Expander Grid.Row="1" Header="אפשרויות חיפוש מתקדמות"
                  Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Padding="0,8">

                <CheckBox Grid.Row="0" Grid.Column="0"
                          Content="חיפוש גמיש (Fuzzy)"
                          IsChecked="{x:Bind ViewModel.Fuzzy, Mode=TwoWay}"/>
                <CheckBox Grid.Row="0" Grid.Column="1"
                          Content="כל המילים (AND)"
                          IsChecked="{x:Bind ViewModel.Conjunction, Mode=TwoWay}"/>
                <CheckBox Grid.Row="0" Grid.Column="2"
                          Content="כתיב מלא/חסר"
                          IsChecked="{x:Bind ViewModel.FullSpelling, Mode=TwoWay}"/>

                <CheckBox Grid.Row="1" Grid.Column="0"
                          Content="הרחב תחיליות (ו/ה/ב...)"
                          IsChecked="{x:Bind ViewModel.AddPrefixes, Mode=TwoWay}"/>
                <CheckBox Grid.Row="1" Grid.Column="1"
                          Content="הרחב סיומות (ים/ות...)"
                          IsChecked="{x:Bind ViewModel.AddSuffixes, Mode=TwoWay}"/>

                <!-- מרחק Fuzzy -->
                <StackPanel Grid.Row="1" Grid.Column="2"
                            Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind ViewModel.Fuzzy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="מרחק:" VerticalAlignment="Center"/>
                    <NumberBox Minimum="0" Maximum="2"
                               Value="{x:Bind ViewModel.FuzzyDistance, Mode=TwoWay}"
                               SpinButtonPlacementMode="Inline"
                               Width="100"/>
                </StackPanel>
            </Grid>
        </Expander>

        <!-- ─── סטטוס ───────────────────────────────────── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                    Margin="0,0,0,8">
            <ProgressRing IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                          Width="20" Height="20"/>
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       VerticalAlignment="Center" FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- ─── תוצאות ──────────────────────────────────── -->
        <ListView Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="Result_ItemClick"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SearchResult">
                    <Grid RowDefinitions="Auto,Auto" Padding="4,6"
                          ColumnDefinitions="*,Auto">

                        <!-- שם ספר + מיקום -->
                        <StackPanel Grid.Row="0" Grid.Column="0"
                                    Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Title}"
                                       FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{x:Bind HeRef}"
                                       FontSize="12" Opacity="0.7"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- ציון -->
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{x:Bind Score}"
                                   FontSize="11" Opacity="0.4"
                                   VerticalAlignment="Center"/>

                        <!-- תצוגה מקדימה -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{x:Bind Content}"
                                   FontSize="12" Opacity="0.8"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2" TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <Button x:Name="LoadMoreBtn"
                        Content="טען עוד תוצאות"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,8"
                        Visibility="{x:Bind ViewModel.HasMoreResults, Mode=OneWay}"
                        Command="{x:Bind ViewModel.LoadMoreResultsCommand}"/>
            </ListView.Footer>
        </ListView>

    </Grid>
</ContentDialog>
