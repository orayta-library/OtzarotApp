<UserControl
    x:Class="OtzarotApp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:OtzarotApp.ViewModels"
    x:DefaultBindMode="OneWay"
    FlowDirection="RightToLeft">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4" Padding="24,16,24,32" MaxWidth="860">

            <!-- ══ מסד נתונים ══════════════════════════════════ -->
            <TextBlock Text="מסד נתונים"
                       FontSize="13" Opacity="0.6"
                       Margin="4,16,4,4"/>

            <controls:SettingsExpander Header="מסד נתונים (seforim.db)"
                                       IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE838;"/>
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="קובץ seforim.db"
                                           Description="{x:Bind ViewModel.DbPath, Mode=OneWay}">
                        <Button Content="בחר קובץ..."
                                Command="{x:Bind ViewModel.BrowseDbPathCommand}"/>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- ══ מנוע חיפוש ══════════════════════════════════ -->
            <TextBlock Text="מנוע חיפוש"
                       FontSize="13" Opacity="0.6"
                       Margin="4,16,4,4"/>

            <controls:SettingsExpander Header="מנוע חיפוש (Tantivy)"
                                       IsExpanded="False">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE721;"/>
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="קובץ tantivy_search.exe"
                                           Description="{x:Bind ViewModel.TantivyPath, Mode=OneWay}">
                        <Button Content="בחר קובץ..."
                                Command="{x:Bind ViewModel.BrowseTantivyPathCommand}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="תיקיית אינדקס"
                                           Description="{x:Bind ViewModel.IndexPath, Mode=OneWay}">
                        <Button Content="בחר תיקיה..."
                                Command="{x:Bind ViewModel.BrowseIndexPathCommand}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="בניית אינדקס"
                                           Description="סרוק מחדש את כל הספרים לאינדקס חיפוש">
                        <StackPanel Orientation="Horizontal" Spacing="8" FlowDirection="RightToLeft">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsBuildingIndex, Mode=OneWay}"
                                          Width="20" Height="20"/>
                            <Button Content="בנה אינדקס"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.BuildIndexCommand}"/>
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="לוג בנייה">
                        <ScrollViewer MaxHeight="120" HorizontalAlignment="Stretch"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{x:Bind ViewModel.BuildProgress, Mode=OneWay}"
                                       FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                        </ScrollViewer>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- ══ עיצוב טקסט ══════════════════════════════════ -->
            <TextBlock Text="עיצוב טקסט"
                       FontSize="13" Opacity="0.6"
                       Margin="4,16,4,4"/>

            <controls:SettingsExpander Header="גופן" IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8D2;"/>
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="גופן">
                        <ComboBox ItemsSource="{x:Bind ViewModel.InstalledFonts, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFont, Mode=TwoWay}"
                                  Width="220"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="גודל גופן">
                        <StackPanel Orientation="Horizontal" Spacing="10" FlowDirection="RightToLeft">
                            <TextBlock Text="{x:Bind ViewModel.FontSizeText, Mode=OneWay}"
                                       VerticalAlignment="Center" Width="28" TextAlignment="Center"/>
                            <Slider Minimum="10" Maximum="48" StepFrequency="1"
                                    Value="{x:Bind ViewModel.FontSize, Mode=TwoWay}"
                                    Width="200"/>
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="תצוגה מקדימה">
                        <Border Padding="12,8" CornerRadius="6"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <TextBlock Text="בְּרֵאשִׁית בָּרָא אֱלֹהִים אֵת הַשָּׁמַיִם וְאֵת הָאָרֶץ"
                                       FontFamily="{x:Bind ViewModel.SelectedFont, Mode=OneWay}"
                                       FontSize="{x:Bind ViewModel.FontSize, Mode=OneWay}"
                                       FlowDirection="RightToLeft" TextWrapping="Wrap"/>
                        </Border>
                    </controls:SettingsCard>
                    <controls:SettingsCard>
                        <Button Content="שמור הגדרות גופן"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SaveFontSettingsCommand}"/>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- ══ מראה ════════════════════════════════════════ -->
            <TextBlock Text="מראה"
                       FontSize="13" Opacity="0.6"
                       Margin="4,16,4,4"/>

            <controls:SettingsExpander Header="ערכת נושא" IsExpanded="False">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE790;"/>
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="ערכת צבעים"
                                           Description="בחר בין מצב בהיר, כהה, או ברירת המחדל של המערכת">
                        <StackPanel Orientation="Horizontal" Spacing="8" FlowDirection="RightToLeft">
                            <ComboBox ItemsSource="{x:Bind ViewModel.Themes}"
                                      SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                                      Width="160"/>
                            <Button Content="החל"
                                    Command="{x:Bind ViewModel.SaveThemeCommand}"/>
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- ══ סטטוס ════════════════════════════════════════ -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Severity="Informational"
                     IsClosable="False"
                     Margin="0,12,0,0"/>

            <!-- ══ אודות ════════════════════════════════════════ -->
            <TextBlock Text="אודות האפליקציה"
                       FontSize="13" Opacity="0.6"
                       Margin="4,20,4,4"/>

            <controls:SettingsCard>
                <controls:SettingsCard.Header>אוצרות — ספרי קודש</controls:SettingsCard.Header>
                <controls:SettingsCard.Description>גרסה 1.0 · WinUI 3 · מנוע Tantivy · מאגר אוצריא</controls:SettingsCard.Description>
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE736;"/>
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</UserControl>
