<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:OtzarotApp.Converters">

    <!-- ── Converters ───────────────────────────────────────── -->
    <converters:BoolToVisibilityConverter      x:Key="BoolToVisibilityConverter"/>
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    <converters:BoolNegConverter               x:Key="BoolNegConverter"/>
    <converters:ListToVisibilityConverter      x:Key="ListToVisibilityConverter"/>
    <converters:IntToBoolConverter             x:Key="IntToBoolConverter"/>
    <converters:FloatToStringConverter         x:Key="FloatToStringConverter"/>

    <!-- ── BookPanel shadow ─────────────────────────────────── -->
    <ThemeShadow x:Name="BookPanelShadow"/>

    <!-- ── BookPanel border style ───────────────────────────── -->
    <Style x:Key="BookPanelBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    </Style>

    <!-- ── Subtle button (no background) ───────────────────── -->
    <Style x:Key="SubtleButtonStyle" TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <!-- ── כותרת אזור ────────────────────────────────────────  -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

</ResourceDictionary>
